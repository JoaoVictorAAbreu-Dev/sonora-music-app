# Copy to apps/api/.env for local development (git-ignored). Never commit real values.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Local PostgreSQL from infra/docker-compose.dev.yml
DATABASE_URL=postgres://sonora:sonora_dev_password@localhost:5432/sonora
# Comma-separated browser origins allowed by CORS (native apps send no Origin). Empty = none.
CORS_ORIGINS=
APP_VERSION=dev
# Reverse proxies in front of the API (1 behind Caddy, 0 locally).
TRUST_PROXY_HOPS=0

# --- Auth ---
# HMAC secret for access tokens, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime in seconds (default 900 = 15 min).
ACCESS_TOKEN_TTL=900
# Refresh token lifetime in seconds (default 2592000 = 30 days).
REFRESH_TOKEN_TTL=2592000
# Requests per client IP per minute across /v1/auth/*.
AUTH_RATE_LIMIT_PER_IP=30
# Login/register attempts per email per 15 minutes.
AUTH_RATE_LIMIT_PER_EMAIL=10
