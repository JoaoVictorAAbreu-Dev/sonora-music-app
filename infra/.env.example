# Copy to infra/.env on the VM (git-ignored, chmod 600). Never commit real values.
# Public hostname of the API; Caddy obtains the TLS certificate for it automatically.
API_DOMAIN=api.example.com
# Contact e-mail for Let's Encrypt.
ACME_EMAIL=ops@example.com
POSTGRES_DB=sonora
POSTGRES_USER=sonora
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Access token signing secret (>= 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
AUTH_RATE_LIMIT_PER_IP=30
AUTH_RATE_LIMIT_PER_EMAIL=10
# Jamendo API client id (only the API uses it)
JAMENDO_CLIENT_ID=
# Image tag built by the deploy workflow (M8); defaults to a locally built image.
API_IMAGE=sonora-api:local
APP_VERSION=unknown
LOG_LEVEL=info
CORS_ORIGINS=
# Backups (infra/backup.sh): Cloud Storage bucket name, without gs://
BACKUP_BUCKET=

# Password reset e-mails. none = not sent (until a provider is chosen, Q14); smtp = send.
MAIL_PROVIDER=none
# Secret. smtps://user:password@host:465 from your e-mail provider.
SMTP_URL=
# Sender on a domain with SPF/DKIM set up at the provider.
MAIL_FROM=
# Use the HTTPS bridge page so the link works in mail apps (they block sonora:// links).
PASSWORD_RESET_URL=https://api.example.com/reset-password

# Google / Apple sign-in: OAuth client ids / bundle id (open question Q7). Empty = disabled.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
