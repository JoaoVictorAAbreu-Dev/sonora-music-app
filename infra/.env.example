# Copy to infra/.env on the VM (git-ignored, chmod 600). Never commit real values.
# Public hostname of the API; Caddy obtains the TLS certificate for it automatically.
API_DOMAIN=api.example.com
# Contact e-mail for Let's Encrypt.
ACME_EMAIL=ops@example.com
POSTGRES_DB=sonora
POSTGRES_USER=sonora
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Image tag built by the deploy workflow (M8); defaults to a locally built image.
API_IMAGE=sonora-api:local
APP_VERSION=unknown
LOG_LEVEL=info
CORS_ORIGINS=
# Backups (infra/backup.sh): Cloud Storage bucket name, without gs://
BACKUP_BUCKET=
