{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Static legal pages (privacy policy). Everything else goes to the API.
	handle /privacy {
		root * /srv/site
		rewrite * /privacy.html
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
		file_server
	}

	# Bridge for password reset e-mails: mail apps block sonora:// links, so the e-mail points here
	# and this page opens the app. The token travels in the URL fragment, which browsers never send,
	# so it never reaches these logs. The CSP hash must match the inline script (checked by a test).
	handle /reset-password {
		root * /srv/site
		rewrite * /reset-password.html
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'sha256-SipndjtRwuJ+sSLVP20DwKncsYL2M5+4C+H2iCLX/OM='; frame-ancestors 'none'"
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy api:3000 {
			health_uri /health
			health_interval 10s
		}
	}

	# JSON access logs. Caddy redacts Authorization and Cookie headers by default
	# (log_credentials is off), so tokens never reach these logs.
	log {
		output stdout
		format json
	}
}
